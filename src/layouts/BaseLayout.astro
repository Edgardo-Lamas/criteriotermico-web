---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WhatsAppFloat from "../components/WhatsAppFloat.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  // WhatsApp descarta la imagen (y a veces la tarjeta entera) cuando tiene que
  // salir a medirla él mismo. Declararlas es gratis y es lo primero que se revisa
  // cuando la preview no aparece. Las dos imágenes OG del sitio son 1200x630; si
  // alguna vez se sube una de otra medida hay que pasarla por props, no mentir acá.
  ogImageWidth?: number;
  ogImageHeight?: number;
  canonicalUrl?: string;
  hideChrome?: boolean;
  noindex?: boolean;
  // Un `noindex` genérico también frena a los crawlers de preview: el de
  // Facebook/WhatsApp no arma la tarjeta del enlace en una página marcada así.
  // Con esto el noindex se dirige solo a los buscadores, que es lo que se quiere
  // en una página privada que igual se comparte por mensaje (la propuesta
  // comercial). No usarlo en páginas que no se comparten, como /panel.
  permitirPreviewSocial?: boolean;
}

const { title, description, ogImage = "/images/og-default.jpg", ogImageWidth = 1200, ogImageHeight = 630, canonicalUrl, hideChrome = false, noindex = false, permitirPreviewSocial = false } = Astro.props;
// El tipo se deduce de la extensión en vez de fijarse a mano: el sitio ya tuvo un
// archivo con bytes JPEG llamado .png, y servido con el `nosniff` del vercel.json
// un crawler que confía en la cabecera lo descarta sin decir nada.
const ogImageType = ogImage.endsWith(".jpg") || ogImage.endsWith(".jpeg") ? "image/jpeg" : "image/png";
const currentPath = Astro.url.pathname;
// Única fuente de verdad: `site` en astro.config.mjs. Cuando esto era una constante
// hardcodeada acá, el dominio quedó duplicado en seis archivos y al cambiarlo se
// actualizaba solo uno — el canonical y la og:image seguían apuntando a un dominio
// muerto. Al comprar el dominio propio alcanza con tocar astro.config.mjs.
const siteUrl = Astro.site!.origin;
const fullCanonical = canonicalUrl || `${siteUrl}${currentPath}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={fullCanonical} />
    {noindex &&
      (permitirPreviewSocial ? (
        <>
          <meta name="googlebot" content="noindex, nofollow" />
          <meta name="bingbot" content="noindex, nofollow" />
        </>
      ) : (
        <meta name="robots" content="noindex, nofollow" />
      ))}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:image:secure_url" content={`${siteUrl}${ogImage}`} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:url" content={fullCanonical} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="Criterio Térmico" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Preconnect to Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Runs before first paint so [data-reveal] only hides content when JS
         can actually reveal it again (see .js-reveal rules in global.css) -->
    <script is:inline>
      document.documentElement.classList.add("js-reveal");
    </script>
  </head>
  <body>
    {!hideChrome && <Header currentPath={currentPath} />}

    <main>
      <slot />
    </main>

    {!hideChrome && <Footer />}
    {!hideChrome && <WhatsAppFloat />}

    <script>
      if (typeof IntersectionObserver !== "undefined") {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            }
          },
          // threshold 0 + margen inferior positivo: la sección arranca a
          // revelarse antes de entrar en pantalla, así llega ya legible.
          // Con threshold 0.1 las secciones más altas que el viewport
          // disparaban tarde y se leían a medio aparecer.
          { threshold: 0, rootMargin: "0px 0px 15% 0px" }
        );
        document.querySelectorAll("[data-reveal]").forEach((el) => io.observe(el));

        // Red de seguridad: un renderer que no scrollea (un crawler, un
        // servicio de preview) nunca dispara el observer y se llevaría la
        // página con las secciones invisibles. Pasado un margen, se muestran.
        setTimeout(() => {
          document.querySelectorAll("[data-reveal]").forEach((el) => el.classList.add("is-visible"));
        }, 2500);
      } else {
        document.querySelectorAll("[data-reveal]").forEach((el) => el.classList.add("is-visible"));
      }
    </script>
  </body>
</html>
