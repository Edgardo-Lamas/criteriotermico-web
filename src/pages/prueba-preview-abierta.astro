---
import BaseLayout from "../layouts/BaseLayout.astro";

// PÁGINA TEMPORAL DE DIAGNÓSTICO — BORRAR junto con /prueba-preview.
//
// La pareja de /prueba-preview: misma URL nueva y mismos metatags, pero SIN nada de
// la configuración de página privada — sin `noindex`, sin `X-Robots-Tag`. Es la
// segunda variable de control, y entre las dos se lee el resultado de un solo tiro:
//
//   ambas muestran preview   → la configuración está bien; lo de /sanitarios-san-martin
//                              es el caché de la URL vieja.
//   solo esta muestra        → el `noindex` (o el X-Robots-Tag) es lo que frena al
//                              crawler, aunque esté dirigido a googlebot/bingbot.
//   ninguna muestra          → no es ni el caché ni el noindex; hay que seguir buscando.
//
// Va fuera del sitemap igual (astro.config.mjs) para no ofrecerle a Google una página
// vacía mientras dure la prueba.
---

<BaseLayout
  title="Criterio Térmico — Planteo de trabajo conjunto"
  description="Plataforma técnica independiente para instaladores de calefacción por radiadores: cálculo, diseño sobre plano, presupuesto y lista de materiales. Presentado a Sanitarios San Martín."
  ogImage="/images/og-sanitarios.png"
  hideChrome
>
  <main class="prueba">
    <h1>Página de prueba (abierta)</h1>
    <p>
      Esta página existe solo para probar la vista previa de los enlaces. No tiene
      contenido y se borra cuando termine la prueba.
    </p>
  </main>
</BaseLayout>

<style>
  .prueba {
    max-width: 40rem;
    margin: 0 auto;
    padding: 4rem 1.5rem;
  }
</style>
