---
// Pantalla de vuelta desde Mercado Pago. Las tres rutas de /compra la comparten
// porque cambian el mensaje, no la estructura.
//
// MP agrega sus propios parámetros al volver (payment_id, status,
// external_reference, merchant_order_id). El número de operación se muestra
// porque es lo primero que pide el comprador cuando algo no cuadra.
import { siteConfig } from "../config/site";

interface Props {
  tono: "exito" | "error" | "pendiente";
  titulo: string;
  bajada: string;
  mensajeWhatsapp: string;
}

const { tono, titulo, bajada, mensajeWhatsapp } = Astro.props;
const urlWhatsapp = `https://wa.me/${siteConfig.whatsapp}?text=${encodeURIComponent(mensajeWhatsapp)}`;
---

<section class={`resultado resultado--${tono}`}>
  <div class="resultado__icono" aria-hidden="true">
    {tono === "exito" && (
      <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" />
      </svg>
    )}
    {tono === "error" && (
      <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10" /><line x1="15" y1="9" x2="9" y2="15" /><line x1="9" y1="9" x2="15" y2="15" />
      </svg>
    )}
    {tono === "pendiente" && (
      <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" />
      </svg>
    )}
  </div>

  <h1>{titulo}</h1>
  <p class="resultado__bajada">{bajada}</p>

  <p class="resultado__operacion" data-operacion hidden>
    Número de operación: <strong data-operacion-id></strong>
  </p>

  <div class="resultado__acciones">
    <a href={urlWhatsapp} target="_blank" rel="noopener noreferrer" class="resultado__btn resultado__btn--primario">
      Escribinos por WhatsApp
    </a>
    <a href="/repuestos" class="resultado__btn">Volver a repuestos</a>
  </div>
</section>

<style>
  .resultado {
    max-width: 560px;
    margin: 0 auto;
    padding: 64px 24px 80px;
    text-align: center;
  }

  .resultado__icono { margin-bottom: 20px; }
  .resultado--exito .resultado__icono { color: #2e7d32; }
  .resultado--error .resultado__icono { color: #a32b2b; }
  .resultado--pendiente .resultado__icono { color: #b8790a; }

  .resultado h1 { margin: 0 0 12px; font-size: 1.75rem; line-height: 1.25; }
  .resultado__bajada { margin: 0 0 24px; color: #4a4a4a; line-height: 1.6; }

  .resultado__operacion {
    margin: 0 0 24px;
    padding: 10px 14px;
    border-radius: 6px;
    background: #f4f2ee;
    font-size: 0.85rem;
    color: #4a4a4a;
    word-break: break-all;
  }

  .resultado__acciones { display: flex; flex-direction: column; gap: 10px; }

  .resultado__btn {
    display: block;
    padding: 13px 20px;
    border-radius: 8px;
    border: 1px solid #d8d3c9;
    color: #2c2c2c;
    text-decoration: none;
    font-weight: 600;
    transition: background 0.2s ease;
  }

  .resultado__btn:hover { background: #f4f2ee; }

  .resultado__btn--primario {
    background: #b8790a;
    border-color: #b8790a;
    color: #fff;
  }

  .resultado__btn--primario:hover { background: #9c6608; }

  @media (min-width: 560px) {
    .resultado__acciones { flex-direction: row; justify-content: center; }
    .resultado__btn { min-width: 190px; }
  }
</style>

<script>
  // El id lo pone MP en la URL al devolver al comprador. Se lee en el cliente
  // porque el sitio es estático: en el build todavía no existe.
  const params = new URLSearchParams(window.location.search);
  const id = params.get("payment_id") || params.get("collection_id");
  const caja = document.querySelector("[data-operacion]") as HTMLElement | null;
  const destino = document.querySelector("[data-operacion-id]");
  if (id && id !== "null" && caja && destino) {
    destino.textContent = id;
    caja.hidden = false;
  }
</script>
