      </div>
    </div>
  </article>
</BaseLayout>

<style>
  /* El documento usa serif, como el PDF del que es transcripción — no las
     tipografías del sitio. Los `font-src`/`style-src` de la CSP en vercel.json ya
     habilitan Google Fonts, así que no hace falta tocarla. */
  @import url("https://fonts.googleapis.com/css2?family=PT+Serif:ital,wght@0,400;0,700;1,400&display=swap");

  .doc {
    --tinta: #1c1c1e;
    --tinta-suave: #46464b;
    --naranja: #c2620d;
    --naranja-claro: #e0932c;
    --linea: #dcdce1;
    --oscuro: #16181c;
    --serif: "PT Serif", Georgia, "Times New Roman", serif;
    --sans: "Hanken Grotesk", -apple-system, BlinkMacSystemFont, sans-serif;

    background: #fff;
    color: var(--tinta);
    font-family: var(--serif);
    font-size: 1.0625rem;
    line-height: 1.72;
  }

  /* ---------- Portada ---------- */

  .portada {
    background: #0a0a0c;
    /* El resplandor cálido de la portada del PDF. */
    background-image: radial-gradient(
      ellipse 70% 60% at 72% 42%,
      rgba(138, 74, 18, 0.95) 0%,
      rgba(61, 33, 9, 0.55) 45%,
      rgba(10, 10, 12, 0) 100%
    );
    color: #fff;
    padding: clamp(56px, 9vw, 104px) 24px clamp(48px, 7vw, 80px);
  }

  .portada__inner {
    max-width: 720px;
    margin: 0 auto;
  }

  .portada__logo {
    width: clamp(104px, 15vw, 136px);
    height: auto;
    display: block;
    margin-bottom: clamp(36px, 6vw, 60px);
  }

  .etiqueta {
    font-family: var(--sans);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--naranja-claro);
    margin: 0 0 18px;
  }

  .portada__titulo {
    font-family: var(--serif);
    font-size: clamp(2.6rem, 8vw, 4rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.015em;
    margin: 0 0 14px;
    color: #fff;
  }

  .portada__sub {
    font-size: clamp(1.25rem, 3.4vw, 1.65rem);
    color: #c6c6cc;
    margin: 0 0 34px;
  }

  .portada__resumen {
    max-width: 30rem;
    color: #b4b4bc;
    margin: 0 0 34px;
  }

  .portada__regla {
    width: 104px;
    height: 4px;
    background: var(--naranja-claro);
  }

  .portada__meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 26px 32px;
    margin: clamp(56px, 9vw, 96px) 0 0;
    padding-top: 26px;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }

  .portada__meta div {
    min-width: 0;
  }

  .portada__meta dt {
    font-family: var(--sans);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #8d8d96;
    margin-bottom: 7px;
  }

  .portada__meta dd {
